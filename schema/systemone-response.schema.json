{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lovelacemadeline/mlx-lm-as-classifiers/schema/v1/response.json",
  "title": "SystemOneResponse",
  "type": "object",
  "required": ["model", "answers", "usage"],
  "additionalProperties": false,
  "properties": {
    "model": { "type": "string" },
    "answers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Answer" }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer", "description": "Always 0: nothing is decoded." },
        "cached_tokens": { "type": "integer", "description": "x-local. Prefix tokens served from the KV cache." }
      }
    },
    "timing_ms": {
      "type": "object",
      "description": "x-local. Wall-clock breakdown.",
      "properties": { "prefill": { "type": "number" }, "readout": { "type": "number" }, "total": { "type": "number" } }
    }
  },
  "$defs": {
    "Answer": {
      "oneOf": [
        { "$ref": "#/$defs/NoulAnswer" },
        { "$ref": "#/$defs/ChoiceAnswer" },
        { "$ref": "#/$defs/ScoreAnswer" }
      ]
    },
    "Debug": {
      "type": "object",
      "description": "x-local. Present when options.debug is true.",
      "properties": {
        "readout_position": { "type": "integer" },
        "option_token_ids": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer" } } },
        "raw_logits": { "type": "object", "additionalProperties": { "type": "number" } },
        "temperature": { "type": "number" },
        "permutation_spread": { "type": "object", "additionalProperties": { "type": "number" },
          "description": "Per option, max minus min calibrated probability across the options.permutations orderings. Present only when permutations > 1." }
      }
    },
    "NoulAnswer": {
      "type": "object",
      "required": ["type", "noul"],
      "properties": {
        "type": { "const": "noul" },
        "noul": { "type": "number", "minimum": 0, "maximum": 1, "description": "Calibrated P(yes)." },
        "raw_noul": { "type": "number", "minimum": 0, "maximum": 1, "description": "x-local. Uncalibrated P(yes)." },
        "debug": { "$ref": "#/$defs/Debug" }
      }
    },
    "ChoiceAnswer": {
      "type": "object",
      "required": ["type", "choice", "probabilities", "confidence"],
      "properties": {
        "type": { "const": "choice" },
        "choice": { "type": "string" },
        "probabilities": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Calibrated; sums to 1 over the declared options." },
        "raw_probabilities": { "type": "object", "additionalProperties": { "type": "number" }, "description": "x-local. Before temperature scaling." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Calibrated probability of the chosen option (see docs/reference/wire-schema.md for the definition)." },
        "debug": { "$ref": "#/$defs/Debug" }
      }
    },
    "ScoreAnswer": {
      "type": "object",
      "required": ["type", "score", "legend", "probabilities", "confidence"],
      "properties": {
        "type": { "const": "score" },
        "score": { "type": "integer", "minimum": 0, "description": "Index into legend (argmax)." },
        "expected_score": { "type": "number", "description": "x-local. Probability-weighted mean index; use when you want a continuous value." },
        "legend": { "type": "object", "additionalProperties": { "type": "string" } },
        "probabilities": { "type": "object", "additionalProperties": { "type": "number" } },
        "raw_probabilities": { "type": "object", "additionalProperties": { "type": "number" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "debug": { "$ref": "#/$defs/Debug" }
      }
    }
  }
}
